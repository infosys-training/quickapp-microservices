{
  "consumer": {
    "name": "OrderService"
  },
  "interactions": [
    {
      "description": "a request for a non-existent customer",
      "providerStates": [
        {
          "name": "no customer with the specified ID exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/customer/00000000-0000-0000-0000-000000000000"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "a request for all customers",
      "providerStates": [
        {
          "name": "customers exist in the system"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/customer"
      },
      "response": {
        "body": [
          {
            "email": "alice@example.com",
            "fullName": "Alice Smith",
            "id": "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f"
          }
        ],
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].fullName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for customer details by ID",
      "providerStates": [
        {
          "name": "a customer with the specified ID exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/customer/c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f"
      },
      "response": {
        "body": {
          "email": "alice@example.com",
          "fullName": "Alice Smith",
          "id": "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.fullName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.27",
      "models": "1.2.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "CustomerService"
  }
}